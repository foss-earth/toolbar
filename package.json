{
  "name": "@foss-earth/toolbar",
  "version": "0.1.0",
  "private": true,
  "description": "Injected bottom HUD, launcher/readout presentation and Interface sections.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./legacy": {
      "source": "./src/legacy/index.ts",
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.js"
    },
    "./styles.css": {
      "source": "./src/styles/toolbar.css",
      "default": "./dist/styles/toolbar.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:consumer": "node tests/package-consumer.mjs",
    "typecheck:consumer": "tsc -p fixtures/consumer/tsconfig.json",
    "ci": "npm run check:implementation",
    "check:implementation": "npm run typecheck && npm run lint && npm test && npm run build && npm run typecheck:consumer && npm run test:consumer"
  },
  "peerDependencies": {
    "@foss-earth/ui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@foss-earth/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6"
  }
}
